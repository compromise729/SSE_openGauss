+++ b/team_week/li_mengde/LMD-01/run-module.sh
@@ -0,0 +1,161 @@
+#!/usr/bin/env bash
+# Invoke in a fresh disposable database with SSE_init.sql already installed.
+set -euo pipefail
+if [[ $# != 4 ]]; then
+    echo 'Usage: bash run-module.sh SOCKET_DIRECTORY PORT DATABASE ISOLATED_CLIENT_DIRECTORY' >&2
+    exit 2
+fi
+here=$(cd -- "$(dirname -- "$0")" && pwd)
+socket=$(realpath -- "$1")
+state=$(realpath -- "$4")
+repo=/opt/og/openGauss-server
+if [[ ! -S "$socket/.s.PGSQL.$2" || ! "$socket" -ef "$state/../socket" ||
+      ! -d "$state" || ! -d "$repo/sse_storage" ]]; then
+    echo 'Use a local test socket directory and a separate client state directory.' >&2
+    exit 2
+fi
+if [[ ! "$state" -ef "$repo/sse_storage" || "$state" == "$repo/sse_storage" ]]; then
+    echo 'Bind the isolated client state in the same private namespace as the server.' >&2
+    exit 2
+fi
+cd "$here"
+sql=(gsql -X -h "$socket" -p "$2" -d "$3" -v ON_ERROR_STOP=1)
+scratch=$(mktemp -d)
+phase=setup
+finish() {
+    local status=$?
+    rm -f -- "$scratch"/{audit,check,before,after,db-before,db-after,row_aead_tables.v1,sse_table.mat}
+    rmdir -- "$scratch"
+    printf '{"task":"LMD-01","phase":"%s","exit_code":%s,"passed":%s}\n' \
+        "$phase" "$status" "$([[ $status == 0 ]] && echo true || echo false)"
+}
+trap finish EXIT
+
+"${sql[@]}" -c 'SELECT current_database(), version()'
+"${sql[@]}" -f SSE_v1.sql
+"${sql[@]}" -f storage-fixture.sql
+
+phase=create_registration
+fixture_create() {
+    local logical_name=$1
+    "${sql[@]}" -v logical_name="$logical_name" -f - <<'SQL' || return $?
+SELECT public.sse_v1_create('public', :'logical_name');
+SQL
+    printf '%s\t%s\tpublic\t%s\t1\n' "$deployment" "$database_oid" "$logical_name" >> "$scratch/row_aead_tables.v1" || return
+    printf '%s keyword|FIDES\n' "$logical_name" >> "$scratch/sse_table.mat"
+}
+
+mapping_digest() {
+    sha256sum "$scratch/row_aead_tables.v1" "$scratch/sse_table.mat"
+}
+
+deployment=11111111111111111111111111111111
+database_oid=$("${sql[@]}" -Atq -c "SELECT oid FROM pg_database WHERE datname=current_database()" |
+    sed -n '/^[0-9][0-9]*$/p')
+[[ "$database_oid" =~ ^[0-9]+$ ]]
+printf 'SSE_ROW_TABLES_V1\n' > "$scratch/row_aead_tables.v1"
+printf 'lmd_legacy keyword|FIDES\n' > "$scratch/sse_table.mat"
+fixture_create lmd_registration_ok
+grep -F $'\tpublic\tlmd_registration_ok\t1' "$scratch/row_aead_tables.v1"
+grep -Fx 'lmd_registration_ok keyword|FIDES' "$scratch/sse_table.mat"
+"${sql[@]}" -c "SELECT public.sse_v1_require_table('public','lmd_registration_ok')"
+echo 'PASS test caller registered both mappings after successful server create'
+
+# Force catalog insertion to fail after both physical CREATE TABLE statements.
+"${sql[@]}" -c "ALTER TABLE public.sse_v1_catalog ADD CONSTRAINT lmd_fixture_reject
+    CHECK (logical_table <> 'lmd_registration_fail')"
+mapping_digest > "$scratch/before"
+if fixture_create lmd_registration_fail > "$scratch/check" 2>&1; then
+    echo 'FAIL test caller accepted failed server create' >&2
+    exit 1
+else
+    printf 'PASS test caller received nonzero create status=%s\n' "$?"
+fi
+cat "$scratch/check"
+grep -F 'violates check constraint "lmd_fixture_reject"' "$scratch/check" >/dev/null
+mapping_digest > "$scratch/after"
+cat "$scratch/before" "$scratch/after"
+diff -u "$scratch/before" "$scratch/after"
+"${sql[@]}" -f - <<'SQL'
+DO $$
+BEGIN
+    IF EXISTS (SELECT 1 FROM pg_tables WHERE schemaname = 'public'
+               AND tablename IN ('lmd_registration_fail_data','lmd_registration_fail_index'))
+       OR EXISTS (SELECT 1 FROM public.sse_v1_catalog WHERE logical_table = 'lmd_registration_fail') THEN
+        RAISE EXCEPTION 'failed create left partial database state';
+    END IF;
+    RAISE NOTICE 'PASS catalog rejection rolled back both physical tables and left no catalog entry';
+END;
+$$;
+ALTER TABLE public.sse_v1_catalog DROP CONSTRAINT lmd_fixture_reject;
+SQL
+echo 'PASS failed create left both fixture mapping files byte-identical'
+
+phase=read_only_audit
+check_output() {
+    local status=0
+    "$@" > "$scratch/audit" 2>&1 || status=$?
+    cat "$scratch/audit"
+    if (( status != 0 )); then return "$status"; fi
+    if grep -Eq '(NOTICE|WARNING|ERROR):[[:space:]]+(FAIL|SKIP)([[:space:]:]|$)' "$scratch/audit"; then
+        return 4
+    fi
+}
+
+audit() {
+    check_output "${sql[@]}" -v target_schema="$1" -v target="$2" -v profile="$3" -f 李孟德-check.sql
+}
+
+snapshot() {
+    "${sql[@]}" -Atq <<'SQL' | sed '/^total time: /d'
+SELECT count(*), md5(string_agg(rid || ':' || md5(data_blob), ',' ORDER BY rid)) FROM public.lmd_sample_data;
+SELECT count(*), md5(string_agg(ut || ':' || md5(locator_blob), ',' ORDER BY ut)) FROM public.lmd_sample_index;
+SQL
+    find "$state" -maxdepth 1 -type f \( -name '*.mat' -o -name '*.key' \) -print0 |
+        sort -z | xargs -0 -r sha256sum
+}
+
+snapshot > "$scratch/db-before"
+audit public lmd_sample fides_v1
+audit public lmd_sample fides_v1
+snapshot > "$scratch/db-after"
+diff -u "$scratch/db-before" "$scratch/db-after"
+echo 'PASS audit preserved data, index and local counter/key file digests'
+audit public lmd_legacy fides
+
+expect_failure() {
+    local status
+    if audit "$1" "$2" "$3" > "$scratch/check" 2>&1; then
+        cat "$scratch/check"
+        echo 'FAIL a required check exited zero' >&2
+        exit 1
+    else
+        status=$?
+    fi
+    cat "$scratch/check"
+    grep -F "$4" "$scratch/check" >/dev/null
+    printf 'PASS audit rejected %s (%s) with exit code %s\n' "$2" "$3" "$status"
+}
+
+expect_failure public missing fides_v1 'FAIL required schema checks failed'
+expect_failure public lmd_legacy fides_v1 'FAIL required schema checks failed'
+if "${sql[@]}" -c 'fides_v1_select * from public.lmd_legacy_index where token= and derivation_key= and add_count=0;' \
+    > "$scratch/check" 2>&1; then
+    echo 'FAIL v1 wire entry accepted an old table' >&2
+    exit 1
+fi
+grep -F 'unregistered sse_v1 table: lmd_legacy' "$scratch/check"
+echo 'PASS v1 wire entry rejected the old Fides table'
+"${sql[@]}" -c "INSERT INTO public.lmd_legacy_data VALUES ('1','fixture','duplicate')"
+expect_failure public lmd_legacy fides 'FAIL duplicate IDs found'
+for verdict in FAIL SKIP; do
+    if check_output "${sql[@]}" -c "DO \$\$ BEGIN RAISE NOTICE '$verdict synthetic audit outcome'; END; \$\$"; then
+        echo "FAIL summary accepted a $verdict notice" >&2
+        exit 1
+    else
+        [[ $? == 4 ]]
+    fi
+    printf 'PASS summary rejected a %s notice despite successful gsql execution\n' "$verdict"
+done
+echo 'PASS module fixture, positive and negative read-only audits'
+phase=complete
diff --git a/team_week/li_mengde/LMD-01/storage-fixture.sql b/team_week/li_mengde/LMD-01/storage-fixture.sql
new file mode 100644
index 0000000..c6b41bc
--- /dev/null
+++ b/team_week/li_mengde/LMD-01/storage-fixture.sql
@@ -0,0 +1,146 @@
+-- Synthetic envelopes with correct headers and lengths. The tags are test bytes.
+\set ON_ERROR_STOP on
+CREATE TABLE public.lmd_ordinary (rid text PRIMARY KEY, payload text);
+INSERT INTO public.lmd_ordinary VALUES ('plain-01', 'ordinary');
+fides_setup;
+CREATE TABLE lmd_legacy (ind text, keyword text SSE='FIDES', payload text);
+INSERT INTO lmd_legacy VALUES ('1', 'lmdlegacy', 'legacy fixture');
+SELECT * FROM lmd_legacy WHERE keyword='lmdlegacy';
+
+CREATE FUNCTION pg_temp.lmd_blob(purpose integer, payload_bytes integer)
+RETURNS text LANGUAGE sql AS $$
+    SELECT replace(encode(decode('53534531010' || $1, 'hex')
+        || decode(repeat('00', 28), 'hex') || pg_catalog.int4send($2)
+        || decode(repeat('31', $2 + 16), 'hex'), 'base64'), chr(10), '')
+$$;
+
+BEGIN;
+SELECT public.sse_v1_create('public','lmd_create_rollback');
+ROLLBACK;
+
+DO $$
+BEGIN
+    IF EXISTS (SELECT 1 FROM pg_tables WHERE schemaname = 'public'
+               AND tablename IN ('lmd_create_rollback_data','lmd_create_rollback_index'))
+       OR EXISTS (SELECT 1 FROM public.sse_v1_catalog WHERE logical_table = 'lmd_create_rollback') THEN
+        RAISE EXCEPTION 'create rollback left artifacts';
+    END IF;
+    BEGIN
+        PERFORM public.sse_v1_create('public','lmd_legacy');
+        RAISE EXCEPTION 'legacy name was accepted';
+    EXCEPTION WHEN duplicate_table THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_fetch('public','lmd_legacy',ARRAY[]::text[]);
+        RAISE EXCEPTION 'unregistered legacy table was accepted';
+    EXCEPTION WHEN undefined_table THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_create('public','Invalid.name');
+        RAISE EXCEPTION 'invalid identifier was accepted';
+    EXCEPTION WHEN invalid_parameter_value THEN NULL;
+    END;
+    IF NOT EXISTS (SELECT 1 FROM public.lmd_ordinary WHERE rid = 'plain-01' AND payload = 'ordinary') THEN
+        RAISE EXCEPTION 'ordinary SQL failed';
+    END IF;
+    RAISE NOTICE 'PASS DB-01 create rollback, legacy fencing, identifier checks and ordinary SQL';
+END;
+$$;
+
+SELECT public.sse_v1_create('public','lmd_sample');
+DO $$
+DECLARE
+    rid_a text := repeat('a',32);
+    rid_b text := repeat('b',32);
+    rid_c text := repeat('c',32);
+    rid_d text := repeat('d',32);
+    token_a text := repeat('A',22) || '==';
+    token_b text := repeat('B',22) || '==';
+    token_c text := repeat('C',22) || '==';
+    token_d text := repeat('D',22) || '==';
+    token_e text := repeat('E',22) || '==';
+    row_min text := pg_temp.lmd_blob(1,12);
+    row_max text := pg_temp.lmd_blob(1,49164);
+    position text := pg_temp.lmd_blob(2,17);
+    actual text[];
+    before_data text;
+    before_index text;
+    after_data text;
+    after_index text;
+BEGIN
+    IF octet_length(row_min) <> 88 OR octet_length(row_max) <> 65624 OR octet_length(position) <> 96
+       OR NOT EXISTS (SELECT 1 FROM public.sse_v1_catalog WHERE logical_schema = 'public'
+                      AND logical_table = 'lmd_sample' AND protocol_version = 1) THEN
+        RAISE EXCEPTION 'unexpected fixture length or missing catalog registration';
+    END IF;
+    PERFORM public.sse_v1_insert('public','lmd_sample', ARRAY[rid_a,rid_b], ARRAY[row_min,row_max],
+                                 ARRAY[token_a,token_b], ARRAY[position,position]);
+    SELECT array_agg(f.data_blob ORDER BY f.rid) INTO actual
+    FROM public.sse_v1_fetch('public','lmd_sample',ARRAY[rid_b,rid_a]) AS f;
+    IF actual IS DISTINCT FROM ARRAY[row_min,row_max] THEN RAISE EXCEPTION 'row bytes changed'; END IF;
+    SELECT array_agg(p.locator_blob ORDER BY p.ut) INTO actual
+    FROM public.sse_v1_take('public','lmd_sample',ARRAY[token_a,token_c,token_b]) AS p;
+    IF actual IS DISTINCT FROM ARRAY[position,position] THEN RAISE EXCEPTION 'position bytes changed'; END IF;
+    IF EXISTS (SELECT 1 FROM public.sse_v1_take('public','lmd_sample',ARRAY[token_a,token_c]))
+       OR EXISTS (SELECT 1 FROM public.sse_v1_take('public','lmd_sample',ARRAY[]::text[]))
+       OR EXISTS (SELECT 1 FROM public.sse_v1_fetch('public','lmd_sample',ARRAY[]::text[])) THEN
+        RAISE EXCEPTION 'empty request or miss returned rows';
+    END IF;
+    PERFORM public.sse_v1_reinsert('public','lmd_sample',ARRAY[]::text[],ARRAY[]::text[]);
+    PERFORM public.sse_v1_reinsert('public','lmd_sample',ARRAY[token_d,token_e],ARRAY[position,position]);
+    RAISE NOTICE 'PASS synthetic envelopes round trip at 88 and 65624 bytes; 96 byte positions; take/miss/empty/reinsert';
+
+    SELECT md5(string_agg(rid || ':' || md5(data_blob), ',' ORDER BY rid)) INTO before_data FROM public.lmd_sample_data;
+    SELECT md5(string_agg(ut || ':' || md5(locator_blob), ',' ORDER BY ut)) INTO before_index FROM public.lmd_sample_index;
+    BEGIN
+        PERFORM public.sse_v1_insert('public','lmd_sample',ARRAY[rid_c,rid_a,rid_d],ARRAY[row_min,row_min,row_min],
+            ARRAY[token_a,token_b,token_c],ARRAY[position,position,position]);
+        RAISE EXCEPTION 'middle duplicate rid accepted';
+    EXCEPTION WHEN unique_violation THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_insert('public','lmd_sample',ARRAY[rid_c,rid_d],ARRAY[row_min,row_min],
+            ARRAY[token_a,token_d],ARRAY[position,position]);
+        RAISE EXCEPTION 'index collision accepted';
+    EXCEPTION WHEN unique_violation THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_insert('public','lmd_sample',ARRAY[rid_c],ARRAY[pg_temp.lmd_blob(1,49165)],
+            ARRAY[token_a],ARRAY[position]);
+        RAISE EXCEPTION 'oversize row accepted';
+    EXCEPTION WHEN check_violation THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_insert('public','lmd_sample',ARRAY[rid_c],ARRAY[row_min],ARRAY[token_a],ARRAY[position || 'x']);
+        RAISE EXCEPTION 'malformed locator accepted';
+    EXCEPTION WHEN check_violation THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_insert('public','lmd_sample',ARRAY[rid_c],ARRAY[row_min],ARRAY[token_a],ARRAY[]::text[]);
+        RAISE EXCEPTION 'different array lengths accepted';
+    EXCEPTION WHEN invalid_parameter_value THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_insert('public','lmd_sample',ARRAY[rid_c],ARRAY[row_min],ARRAY[token_a],ARRAY[NULL::text]);
+        RAISE EXCEPTION 'NULL array element accepted';
+    EXCEPTION WHEN not_null_violation THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_fetch('public','lmd_sample',ARRAY[rid_a,rid_c]);
+        RAISE EXCEPTION 'missing rid accepted';
+    EXCEPTION WHEN cardinality_violation THEN NULL;
+    END;
+    BEGIN
+        PERFORM public.sse_v1_fetch('public','lmd_sample',ARRAY[rid_a,rid_a]);
+        RAISE EXCEPTION 'duplicate fetch rid accepted';
+    EXCEPTION WHEN cardinality_violation THEN NULL;
+    END;
+    SELECT md5(string_agg(rid || ':' || md5(data_blob), ',' ORDER BY rid)) INTO after_data FROM public.lmd_sample_data;
+    SELECT md5(string_agg(ut || ':' || md5(locator_blob), ',' ORDER BY ut)) INTO after_index FROM public.lmd_sample_index;
+    IF before_data IS NULL OR before_index IS NULL OR before_data IS DISTINCT FROM after_data
+       OR before_index IS DISTINCT FROM after_index OR (SELECT count(*) FROM public.lmd_sample_data) <> 2
+       OR (SELECT count(*) FROM public.lmd_sample_index) <> 2 THEN RAISE EXCEPTION 'failed calls changed tables'; END IF;
+    RAISE NOTICE 'PASS rollback and errors; data before/after %/%; index before/after %/%',
+        before_data, after_data, before_index, after_index;
+END;
+$$;
diff --git "a/team_week/li_mengde/LMD-01/\346\235\216\345\255\237\345\276\267-check.sql" "b/team_week/li_mengde/LMD-01/\346\235\216\345\255\237\345\276\267-check.sql"
new file mode 100644
index 0000000..d0026cf
--- /dev/null
+++ "b/team_week/li_mengde/LMD-01/\346\235\216\345\255\237\345\276\267-check.sql"
@@ -0,0 +1,185 @@
+-- gsql -X -v target_schema=public -v target=lmd_demo -v profile=fides -f 李孟德-check.sql
+-- Profiles: fides_v1, fides, multi, tpch, diana, januspp, orion, mitra, fbdsse, dual, closefb.
+\set ON_ERROR_STOP on
+BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;
+SELECT current_database() AS database, current_user AS connected_user,
+       :'target_schema' AS target_schema, :'target' AS target, :'profile' AS profile;
+SET LOCAL lmd.target_schema TO :'target_schema';
+SET LOCAL lmd.target TO :'target';
+SET LOCAL lmd.profile TO :'profile';
+
+DO $$
+DECLARE
+    ns text := current_setting('lmd.target_schema');
+    target text := current_setting('lmd.target');
+    profile text := current_setting('lmd.profile');
+    function_names text[];
+    signatures text[];
+    tables text[] := ARRAY[target || '_data', target || '_index'];
+    expected text[] := ARRAY['ind,keyword,payload', 'ut,en_ind,join_col'];
+    key_col text := 'ind';
+    actual text;
+    table_name text;
+    qualified text;
+    columns text;
+    valid boolean := true;
+    relation oid;
+    primary_key_ok boolean;
+    row_count bigint;
+    duplicate record;
+    details record;
+    i integer;
+BEGIN
+    CASE profile
+        WHEN 'fides_v1' THEN
+            IF ns <> 'public' THEN
+                RAISE EXCEPTION 'FAIL fides_v1 requires public schema';
+            END IF;
+            function_names := ARRAY['sse_v1_create','sse_v1_insert','sse_v1_take','sse_v1_reinsert','sse_v1_fetch'];
+            signatures := ARRAY['text, text','text, text, text[], text[], text[], text[]',
+                'text, text, text[]','text, text, text[], text[]','text, text, text[]'];
+            expected := ARRAY['rid,data_blob','ut,locator_blob'];
+            key_col := 'rid';
+        WHEN 'fides', 'multi' THEN
+            function_names := ARRAY['sse_create_tables2','fides_insert','fides_re_insert'];
+            signatures := ARRAY['text, text, text, text','text[], text[], text[], text, text','text[], text[], text[], text'];
+            IF profile = 'multi' THEN expected[1] := 'ind,keyword,payload,note'; END IF;
+        WHEN 'mitra' THEN
+            function_names := ARRAY['sse_create_tables2','mitra_insert','mitra_re_insert'];
+            signatures := ARRAY['text, text, text, text','text[], text[], text[], text, text','text[], text[], text[], text'];
+        WHEN 'fbdsse' THEN
+            function_names := ARRAY['fbdsse_create_tables2','fbdsse_insert'];
+            signatures := ARRAY['text, text, text, text','text[], text[], text[], text, text'];
+            expected[2] := 'ut,en_ind,fb_ct';
+        WHEN 'dual' THEN
+            function_names := ARRAY['dual_create_tables2','dual_insert','dual_select'];
+            signatures := ARRAY['text, text, text, text','text[], text[], text[], text, text','text[], text'];
+            expected[2] := 'label1,label2,data';
+        WHEN 'closefb' THEN
+            function_names := ARRAY['closefb_create_tables2','closefb_insert','closefb_select'];
+            signatures := ARRAY['text, text, text, text','text[], text[], text, text','text[], text'];
+            expected[2] := 'indexkey,indexvalue';
+        WHEN 'januspp' THEN
+            function_names := ARRAY['januspp_create_tables2','januspp_insert','januspp_select'];
+            signatures := ARRAY['text, text, text, text','text[], text[], text[], text, text','text[], text'];
+            tables := ARRAY[target || '_data', target || '_indexadd', target || '_indexdel', target || '_cache'];
+            expected := ARRAY['ind,keyword,payload','enckeyword,encind,tag','enckeyword,punckey,deltag','tkn,ind,tag'];
+        WHEN 'orion' THEN
+            function_names := ARRAY['orion_create_tables2'];
+            signatures := ARRAY['text, text, text, text'];
+            tables := ARRAY[target || '_data'];
+            expected := ARRAY['ind,keyword,payload'];
+            RAISE NOTICE 'INFO Orion index state is external to SQL; check the isolated orion_state.bin separately';
+        WHEN 'diana' THEN
+            function_names := ARRAY['diana_insert_bulk'];
+            signatures := ARRAY['text[], text[], text[], text[], text[]'];
+            tables := ARRAY[target || '_datatable', target || '_indextable'];
+            expected := ARRAY['ind,keyword,values','ut,ind'];
+        WHEN 'tpch' THEN
+            function_names := ARRAY['sse_order_create_tables','fides_tpch_insert','fides_tpch_select'];
+            signatures := ARRAY['text, text, text, text, text, text, text, text, text, text',
+                'text[], text[], text[], text[], text[], text[], text[], text[], text[], text[], text[], text',
+                'character varying[], character varying[], character varying[], text'];
+            expected[1] := 'o_orderkey,o_custkey,o_orderstatus,o_totalprice,o_orderdate,o_orderpriority,o_clerk,o_shippriority,o_comment';
+            key_col := 'o_orderkey';
+        ELSE
+            RAISE EXCEPTION 'Unknown inspection profile: %', profile;
+    END CASE;
+
+    FOR i IN 1..array_length(function_names, 1) LOOP
+        SELECT min(oidvectortypes(p.proargtypes)) INTO actual
+        FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
+        WHERE n.nspname = ns AND p.proname = function_names[i]
+              AND oidvectortypes(p.proargtypes) = signatures[i];
+        IF actual IS NULL THEN
+            valid := false;
+            RAISE NOTICE 'FAIL function %.% expected (%) actual missing', ns, function_names[i], signatures[i];
+        ELSE
+            RAISE NOTICE 'PASS function %.% expected (%) actual (%)', ns, function_names[i], signatures[i], actual;
+        END IF;
+    END LOOP;
+
+    FOR i IN 1..array_length(tables, 1) LOOP
+        table_name := tables[i];
+        qualified := format('%I.%I', ns, table_name);
+        SELECT (SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+                WHERE n.nspname = ns AND c.relname = table_name AND c.relkind = 'r') INTO relation;
+        IF relation IS NULL THEN
+            valid := false;
+            RAISE NOTICE 'FAIL table % expected ordinary table actual missing', qualified;
+            CONTINUE;
+        END IF;
+        RAISE NOTICE 'PASS table % expected ordinary table actual present', qualified;
+        SELECT string_agg(attname || ':' || format_type(atttypid, atttypmod), ',' ORDER BY attnum)
+        INTO actual FROM pg_attribute WHERE attrelid = relation AND attnum > 0 AND NOT attisdropped;
+        columns := replace(expected[i], ',', ':text,') || ':text';
+        IF actual IS DISTINCT FROM columns THEN
+            valid := false;
+            RAISE NOTICE 'FAIL columns % expected [%] actual [%]', qualified, columns, actual;
+        ELSE
+            RAISE NOTICE 'PASS columns % expected [%] actual [%]', qualified, columns, actual;
+        END IF;
+        IF profile = 'fides_v1' THEN
+            SELECT EXISTS (
+                SELECT 1 FROM pg_constraint c JOIN pg_attribute a ON a.attrelid = c.conrelid
+                WHERE c.conrelid = relation AND c.contype = 'p' AND c.conkey = ARRAY[a.attnum]
+                      AND a.attname = split_part(expected[i], ',', 1)
+            ) AND NOT EXISTS (
+                SELECT 1 FROM pg_attribute a
+                WHERE a.attrelid = relation AND a.attnum > 0 AND NOT a.attisdropped AND NOT a.attnotnull
+            ) INTO primary_key_ok;
+            IF NOT primary_key_ok THEN
+                valid := false;
+                RAISE NOTICE 'FAIL primary key or nullable columns in %', qualified;
+            END IF;
+        END IF;
+    END LOOP;
+
+    IF NOT valid THEN
+        RAISE EXCEPTION 'FAIL required schema checks failed, rows not inspected';
+    END IF;
+    IF profile = 'fides_v1' THEN
+        PERFORM public.sse_v1_require_table(ns, target);
+        FOR i IN 1..2 LOOP
+            qualified := format('%I.%I', ns, tables[i]);
+            EXECUTE format('SELECT count(*) AS rows, max(octet_length(%1$I)) AS max_cipher_bytes,
+                          count(CASE WHEN NOT public.sse_v1_blob_valid(%1$I, %2$s) THEN 1 END) AS invalid
+                          FROM %3$s', split_part(expected[i], ',', 2), i, qualified) INTO details;
+            IF details.invalid > 0 THEN
+                RAISE EXCEPTION 'FAIL % invalid envelopes %', qualified, details.invalid;
+            END IF;
+            RAISE NOTICE 'PASS % rows % max_cipher_bytes % invalid envelopes 0', qualified, details.rows, details.max_cipher_bytes;
+        END LOOP;
+        RAISE NOTICE 'PASS fides_v1 structure and registration';
+        RETURN;
+    END IF;
+    FOR i IN 1..array_length(tables, 1) LOOP
+        qualified := format('%I.%I', ns, tables[i]);
+        EXECUTE format('SELECT count(*) FROM %s', qualified) INTO row_count;
+        RAISE NOTICE 'ROWS % actual %', qualified, row_count;
+    END LOOP;
+
+    qualified := format('%I.%I', ns, tables[1]);
+    FOR details IN EXECUTE format('SELECT row_to_json(d)::text AS value FROM %s d ORDER BY %I, row_to_json(d)::text LIMIT 20', qualified, key_col) LOOP
+        RAISE NOTICE 'DATA % %', qualified, details.value;
+    END LOOP;
+    valid := true;
+    FOR duplicate IN EXECUTE format('SELECT %1$I AS id, count(*) AS qty FROM %2$s GROUP BY %1$I HAVING count(*) > 1 ORDER BY %1$I', key_col, qualified) LOOP
+        valid := false;
+        RAISE NOTICE 'FAIL duplicate ID % in % actual count % expected 1', duplicate.id, qualified, duplicate.qty;
+    END LOOP;
+    IF NOT valid THEN RAISE EXCEPTION 'FAIL duplicate IDs found in %', qualified; END IF;
+    RAISE NOTICE 'PASS duplicate IDs % expected 0 actual 0', qualified;
+
+    IF profile IN ('fides','multi','tpch') THEN
+        FOR details IN EXECUTE format(
+            'SELECT split_part(i.en_ind,''|'',1) AS id, split_part(i.en_ind,''|'',2) AS operation,
+             length(i.ut) AS ut_length, length(i.join_col) AS auxiliary_length,
+             EXISTS (SELECT 1 FROM %s d WHERE d.%I = split_part(i.en_ind,''|'',1)) AS data_exists
+             FROM %I.%I i ORDER BY i.en_ind LIMIT 20', qualified, key_col, ns, tables[2]) LOOP
+            RAISE NOTICE 'INDEX id % operation % UT length % auxiliary length % data exists %',
+                details.id, details.operation, details.ut_length, details.auxiliary_length, details.data_exists;
+        END LOOP;
+    END IF;
+END $$;
+COMMIT;
-- 
